<?xml version="1.0" encoding="UTF-8"?>
<!-- Riot Office: Calc defaults. See riot-office.xcd for how the files are installed and loaded. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <dependency file="calc"/>

  <!-- New spreadsheets are saved as .xlsx by default. -->
  <oor:component-data oor:package="org.openoffice" oor:name="Setup">
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Calc MS Excel 2007 XML</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- Tabbed user interface (the ribbon-like "notebookbar"). -->
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ToolbarMode">
    <node oor:name="Applications">
      <node oor:name="Calc">
        <prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
