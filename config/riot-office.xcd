<?xml version="1.0" encoding="UTF-8"?>
<!--
  Riot Office: installation-wide LibreOffice defaults.

  Copied by the installers (or "riot-office config install") into:
    Windows:        <LibreOffice>\share\registry\riot-office.xcd
    Ubuntu/Debian:  /etc/libreoffice/registry/riot-office.xcd
  These are defaults, not locks: every user can still change them in Tools > Options.
  Key names checked against officecfg/registry/schema in LibreOffice core.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>

  <!-- Save new documents as .docx / .xlsx / .pptx by default. -->
  <oor:component-data oor:package="org.openoffice" oor:name="Setup">
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>MS Word 2007 XML</value></prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Calc MS Excel 2007 XML</value></prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Impress MS PowerPoint 2007 XML</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <!-- No "keep current format?" question when saving as .docx/.xlsx/.pptx. -->
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="WarnAlienFormat" oor:op="fuse"><value>false</value></prop>
      </node>
    </node>
    <!-- Macros: high security, only signed macros or macros from trusted folders run (level 2). -->
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="MacroSecurityLevel" oor:op="fuse"><value>2</value></prop>
      </node>
    </node>
    <!-- Nothing leaves the PC: no crash report upload, no tip-of-the-day dialog at start. -->
    <node oor:name="Misc">
      <prop oor:name="CrashReport" oor:op="fuse"><value>false</value></prop>
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
    </node>
    <!--
      Font replacement table: Microsoft's newer default fonts, which have no free metric clone,
      are drawn with the closest metric-compatible font when they are missing (Always = false).
      Calibri -> Carlito and Cambria -> Caladea are already built into LibreOffice.
    -->
    <node oor:name="Font">
      <node oor:name="Substitution">
        <prop oor:name="Replacement" oor:op="fuse"><value>true</value></prop>
        <node oor:name="FontPairs">
          <node oor:name="RiotAptos" oor:op="replace">
            <prop oor:name="ReplaceFont"><value>Aptos</value></prop>
            <prop oor:name="SubstituteFont"><value>Carlito</value></prop>
            <prop oor:name="Always"><value>false</value></prop>
            <prop oor:name="OnScreenOnly"><value>false</value></prop>
          </node>
          <node oor:name="RiotAptosDisplay" oor:op="replace">
            <prop oor:name="ReplaceFont"><value>Aptos Display</value></prop>
            <prop oor:name="SubstituteFont"><value>Carlito</value></prop>
            <prop oor:name="Always"><value>false</value></prop>
            <prop oor:name="OnScreenOnly"><value>false</value></prop>
          </node>
          <node oor:name="RiotAptosNarrow" oor:op="replace">
            <prop oor:name="ReplaceFont"><value>Aptos Narrow</value></prop>
            <prop oor:name="SubstituteFont"><value>Liberation Sans Narrow</value></prop>
            <prop oor:name="Always"><value>false</value></prop>
            <prop oor:name="OnScreenOnly"><value>false</value></prop>
          </node>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- Tabbed user interface (the ribbon-like "notebookbar") in Writer, Calc and Impress. -->
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ToolbarMode">
    <node oor:name="Applications">
      <node oor:name="Writer">
        <prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop>
      </node>
      <node oor:name="Calc">
        <prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop>
      </node>
      <node oor:name="Impress">
        <prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
